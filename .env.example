# Quintava runtime settings
# Copy to `.env` only if you want to override defaults.

# Paper trading
STAKE=5
STARTING_BALANCE=100

# General signal engine
MIN_CONFIDENCE=30
HORIZON_MIN=3
COOLDOWN_MIN=3

# 5-minute Polymarket-style strategy
M5_STRATEGY=follow_lead
M5_ENTRY_MIN=1
M5_MIN_MOVE_PCT=0.05
M5_MIN_LAST_CANDLE_PCT=0
M5_MIN_VOLATILITY_PCT=0.02

# Optional Polymarket CLOB credentials for future live-trading experiments.
# Paper trading and the dashboard do not require these values.
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_ADDRESS=
